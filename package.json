    "kleur": "^4.1.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/uuid": "^11.0.0",
