{
  "compilerOptions": {
    // Build Output
    "outDir": "dist",
    "sourceMap": true,
    // Interop & Compatibility
    "baseUrl": "./",
    // Module Resolution
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@/*": ["./src/*"],
      "/*": ["./*"]
    },
    // Language & Type Checking
    "strict": true,
    "target": "ES2023"
  },
  "include": ["src", "types"],
  "exclude": ["node_modules"],
  "ts-node": {
    "files": true,
    "require": ["tsconfig-paths/register"]
  }
}
